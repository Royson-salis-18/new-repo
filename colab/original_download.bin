ty\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.03296620429575479,\n        \"min\": 0.11936503081740053,\n        \"max\": 0.25496206160900364,\n        \"num_unique_values\": 15,\n        \"samples\": [\n          0.21696809757212326,\n          0.2513225732626708\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"max_severity\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.13318727874163208,\n        \"min\": 0.5898774510058948,\n        \"max\": 1.0,\n        \"num_unique_values\": 15,\n        \"samples\": [\n          0.9421484443482839,\n          0.8714363471959259\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"labeled_anomalies\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 9,\n        \"min\": 0,\n        \"max\": 38,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          38,\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":19}],"source":["service_rca = (\n","    df.groupby(\"service\")\n","    .agg(\n","        rows=(\"service\", \"size\"),\n","        predicted_anomalies=(\"predicted_anomaly\", \"sum\"),\n","        anomaly_rate=(\"predicted_anomaly\", \"mean\"),\n","        avg_severity=(\"combined_score\", \"mean\"),\n","        max_severity=(\"combined_score\", \"max\"),\n","        labeled_anomalies=(\"anomaly_label\", \"sum\"),\n","    )\n","    .sort_values(\"predicted_anomalies\", ascending=False)\n",")\n","\n","service_rca"]},{"cell_type":"code","execution_count":20,"id":"4c6332c2","metadata":{"execution":{"iopub.execute_input":"2026-09-17T02:03:56.306765Z","iopub.status.busy":"2026-09-17T02:03:56.306460Z","iopub.status.idle":"2026-09-17T02:03:56.693363Z","shell.execute_reply":"2026-09-17T02:03:56.692635Z"},"colab":{"base_uri":"https://localhost:8080/","height":608},"id":"4c6332c2","executionInfo":{"status":"ok","timestamp":1789624903083,"user_tz":-330,"elapsed":349,"user":{"displayName":"Royson Salis","userId":"14770575586360853572"}},"outputId":"19ac503f-4d17-4eb2-d928-bcd1d635d142"},"outputs":[{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_1149/2860365277.py:3: FutureWarning: \n","\n","Passing `palette` without assigning `hue` is deprecated and will be removed in v0.14.0. Assign the `y` variable to `hue` and set `legend=False` for the same effect.\n","\n","  sns.barplot(x=service_rca.loc[order, \"predicted_anomalies\"], y=order, palette=\"rocket\")\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["plt.figure(figsize=(9, 5))\n","order = service_rca.sort_values(\"predicted_anomalies\", ascending=False).index\n","sns.barplot(x=service_rca.loc[order, \"predicted_anomalies\"], y=order, palette=\"rocket\")\n","plt.title(\"Predicted anomalies by service (Isolation Forest + Z-Score)\")\n","plt.xlabel(\"# anomalous data points\")\n","plt.ylabel(\"service\")\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"e1a63375","metadata":{"id":"e1a63375"},"source":["### Which metric is most often the root cause, per service?\n","\n","For every row flagged as anomalous, `z_max_metric` tells us which metric had the largest deviation from that service's normal baseline. Aggregating this per service tells us **why** each service is anomalous (e.g. CPU spike vs error spike vs network spike)."]},{"cell_type":"code","execution_count":21,"id":"c1a65f8f","metadata":{"execution":{"iopub.execute_input":"2026-09-17T02:03:56.695496Z","iopub.status.busy":"2026-09-17T02:03:56.695275Z","iopub.status.idle":"2026-09-17T02:03:56.717733Z","shell.execute_reply":"2026-09-17T02:03:56.716927Z"},"colab":{"base_uri":"https://localhost:8080/","height":710},"id":"c1a65f8f","