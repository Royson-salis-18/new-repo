"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"network_rx_bytes\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 121889,\n        \"min\": 2458,\n        \"max\": 946107,\n        \"num_unique_values\": 9733,\n        \"samples\": [\n          320923,\n          189386,\n          183385\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"network_tx_bytes\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 209550,\n        \"min\": 126,\n        \"max\": 4053010,\n        \"num_unique_values\": 7921,\n        \"samples\": [\n          63388,\n          39938,\n          161763\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"block_read_bytes\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 13840718,\n        \"min\": 2793472,\n        \"max\": 79912960,\n        \"num_unique_values\": 110,\n        \"samples\": [\n          27709440,\n          25845760,\n          33116160\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"block_write_bytes\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 5082791,\n        \"min\": 0,\n        \"max\": 19218432,\n        \"num_unique_values\": 2418,\n        \"samples\": [\n          9068544,\n          12214272,\n          11005952\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"pids\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 16,\n        \"min\": 6,\n        \"max\": 226,\n        \"num_unique_values\": 41,\n        \"samples\": [\n          36,\n          32,\n          21\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\